{
    "extends": "@repo/typescript-config/base.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "paths": {
            "@repo/api": ["./src/index.ts"],
            "@repo/api/trpc": ["./src/trpc.ts"],
            "@repo/api/shared": ["./src/shared.ts"],
            "@repo/api/routers/*": ["./src/routers/*.ts"],
            "@repo/api/schemas/*": ["./src/schemas/*.ts"],
            "@repo/api/admin": ["./src/admin/index.ts"],
            "@repo/api/admin/*": ["./src/admin/*.ts"]
        }
    },
    "include": ["src"]
}
