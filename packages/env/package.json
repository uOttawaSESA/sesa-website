{
    "name": "@repo/env",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "exports": {
        "./db": {
            "types": "./dist/db.d.ts",
            "import": "./dist/db.js",
            "require": "./dist/db.cjs"
        },
        "./web/server": {
            "types": "./dist/web/server.d.ts",
            "import": "./dist/web/server.js",
            "require": "./dist/web/server.cjs"
        },
        "./web/client": {
            "types": "./dist/web/client.d.ts",
            "import": "./dist/web/client.js",
            "require": "./dist/web/client.cjs"
        },
        "./admin/server": {
            "types": "./dist/admin/server.d.ts",
            "import": "./dist/admin/server.js",
            "require": "./dist/admin/server.cjs"
        },
        "./admin/client": {
            "types": "./dist/admin/client.d.ts",
            "import": "./dist/admin/client.js",
            "require": "./dist/admin/client.cjs"
        }
    },
    "scripts": {
        "build": "tsup && tsc --emitDeclarationOnly",
        "check-types": "tsc --noEmit"
    },
    "dependencies": {
        "@t3-oss/env-core": "^0.13.11",
        "@types/node": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@repo/typescript-config": "workspace:*",
        "typescript": "catalog:"
    }
}
